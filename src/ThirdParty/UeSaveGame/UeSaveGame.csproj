<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Upstream: https://github.com/CrystalFerrai/UeSaveGame
    License : Apache-2.0 (see license.txt in this folder)
    Modified locally: TargetFramework net8.0 -> net10.0, removed x64 platform restriction.
    No source code changes were made to the library itself.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ProductName>UeSaveGame</ProductName>
    <Description>UeSaveGame (vendored, Apache-2.0)</Description>
    <Authors>Crystal Ferrai</Authors>
    <Copyright>Copyright © 2025 Crystal Ferrai</Copyright>
    <Version>0.1.0.0</Version>
    <ProductVersion>$(Version)</ProductVersion>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
