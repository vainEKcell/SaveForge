<Window x:Class="SaveForge.App.BatchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="批量修改"
        Height="380" Width="520"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Background}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="按字段名批量设置值。适合「所有角色等级统一」这类操作。"
                   FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                   TextWrapping="Wrap" Margin="0,0,0,16"/>

        <TextBlock Grid.Row="1" Text="字段名模式"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,6"/>

        <StackPanel Grid.Row="2">
            <TextBox x:Name="TxtPattern" Style="{StaticResource Input}"
                     TextChanged="Input_Changed"/>
            <TextBlock Text="支持 *（任意字符）与 ?（单个字符），例如 Level、*Level*、Gold?"
                       FontSize="11" Foreground="#9AA3AF" Margin="0,5,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="新值"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{StaticResource Brush.TextMuted}" Margin="0,16,0,6"/>

        <StackPanel Grid.Row="4">
            <TextBox x:Name="TxtValue" Style="{StaticResource Input}"
                     TextChanged="Input_Changed"/>
            <TextBlock Text="数值字段填数字，布尔填 true/false，文本直接输入"
                       FontSize="11" Foreground="#9AA3AF" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="5" Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="6" Padding="12,8" Margin="0,16,0,0"
                VerticalAlignment="Top">
            <TextBlock x:Name="TxtPreview" Text="输入字段名模式以预览"
                       FontSize="12" Foreground="{StaticResource Brush.Text}"
                       TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource Btn}" Padding="18,7"
                    IsCancel="True" Click="BtnCancel_Click"/>
            <Button x:Name="BtnApply" Content="应用" Style="{StaticResource BtnPrimary}"
                    Padding="20,7" Margin="10,0,0,0" IsEnabled="False" Click="BtnApply_Click"/>
        </StackPanel>
    </Grid>
</Window>
