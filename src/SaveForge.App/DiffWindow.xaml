<Window x:Class="SaveForge.App.DiffWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="存档对比"
        Height="680" Width="1080"
        MinHeight="420" MinWidth="820"
        Background="{StaticResource Brush.Background}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 文件与统计 -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="基准  " FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtFileA" FontSize="13" Foreground="{StaticResource Brush.Text}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="对比  " FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtFileB" FontSize="13" Foreground="{StaticResource Brush.Text}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" x:Name="TxtSummary"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Accent}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- 差异分类计数 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Border Background="#ECFDF5" CornerRadius="5" Padding="10,4" Margin="0,0,8,0">
                <TextBlock x:Name="TxtAdded" FontSize="12" Foreground="#047857"/>
            </Border>
            <Border Background="#FEF2F2" CornerRadius="5" Padding="10,4" Margin="0,0,8,0">
                <TextBlock x:Name="TxtRemoved" FontSize="12" Foreground="#B91C1C"/>
            </Border>
            <Border Background="#FFF7ED" CornerRadius="5" Padding="10,4">
                <TextBlock x:Name="TxtModified" FontSize="12" Foreground="#C2410C"/>
            </Border>
        </StackPanel>

        <!-- 差异列表 -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="6">
            <ListView x:Name="DiffList"
                      BorderThickness="0"
                      Background="Transparent"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="字段路径" Width="400" DisplayMemberBinding="{Binding Path}"/>
                        <GridViewColumn Header="变化" Width="70" DisplayMemberBinding="{Binding KindText}"/>
                        <GridViewColumn Header="基准值" Width="220" DisplayMemberBinding="{Binding ValueA}"/>
                        <GridViewColumn Header="对比值" Width="220" DisplayMemberBinding="{Binding ValueB}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>

        <TextBlock Grid.Row="3" x:Name="TxtHint" Margin="4,10,0,0"
                   FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
