<Window x:Class="SaveForge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SaveForge · 存档修改器"
        Height="760" Width="1200"
        MinHeight="520" MinWidth="920"
        Background="{StaticResource Brush.Background}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 工具栏 ==================== -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="12,10"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnOpen" Content="打开存档" Style="{StaticResource BtnPrimary}"
                            Click="BtnOpen_Click"/>
                    <Button x:Name="BtnSave" Content="保存修改" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" IsEnabled="False" Click="BtnSave_Click"/>
                    <Button x:Name="BtnBackup" Content="生成备份" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" IsEnabled="False" Click="BtnBackup_Click"/>
                    <Button x:Name="BtnDiff" Content="对比存档" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" IsEnabled="False" Click="BtnDiff_Click"/>
                    <Button x:Name="BtnBatch" Content="批量修改" Style="{StaticResource Btn}"
                            Margin="8,0,0,0" IsEnabled="False" Click="BtnBatch_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnExportJson" Content="导出 JSON" Style="{StaticResource Btn}"
                            Padding="10,5" Margin="0,0,6,0" IsEnabled="False"
                            Click="BtnExportJson_Click"/>
                    <Button x:Name="BtnImportJson" Content="导入 JSON" Style="{StaticResource Btn}"
                            Padding="10,5" Margin="0,0,12,0" IsEnabled="False"
                            Click="BtnImportJson_Click"/>
                    <TextBlock x:Name="TxtFileName" Text="未打开文件"
                               FontSize="13" Foreground="{StaticResource Brush.TextMuted}"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                    <Border x:Name="BadgeFormat" Background="{StaticResource Brush.Subtle}"
                            CornerRadius="5" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtFormat" Text="—"
                                   FontSize="11" Foreground="{StaticResource Brush.TextMuted}"/>
                    </Border>
                    <Button x:Name="BtnLoadDatabase" Content="物品库" Style="{StaticResource Btn}"
                            Padding="10,5" Margin="0,0,6,0" IsEnabled="False"
                            ToolTip="载入游戏的 Items.json / Weapons.json / Armors.json，把物品 ID 显示成中文名称"
                            Click="BtnLoadDatabase_Click"/>
                    <Button x:Name="BtnAbout" Content="关于" Style="{StaticResource Btn}"
                            Padding="10,5" Margin="6,0,0,0" Click="BtnAbout_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 主区域 ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="380" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- 字段树 -->
            <Border Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="16,12,16,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="字段" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center"/>

                        <TextBox x:Name="TxtSearch" Grid.Column="1"
                                 Style="{StaticResource Input}"
                                 Padding="7,4" FontSize="12" Margin="12,0,0,0"
                                 ToolTip="按字段名或值过滤（Ctrl+F 聚焦，Esc 清空）"
                                 TextChanged="TxtSearch_TextChanged"/>
                    </Grid>

                    <TreeView x:Name="FieldTree" Grid.Row="1"
                              Margin="8,0,8,10"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource FieldTreeItem}"
                              SelectedItemChanged="FieldTree_SelectedItemChanged"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <Grid MinHeight="22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}" FontSize="13"
                                               Foreground="{StaticResource Brush.Text}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="●" FontSize="10" Margin="4,0,0,0"
                                               Foreground="{StaticResource Brush.Modified}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2" Text="{Binding KindLabel}" FontSize="10"
                                               Foreground="#9AA3AF" Margin="8,1,0,0"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="{Binding ValueText}" FontSize="12"
                                               Foreground="{StaticResource Brush.Accent}"
                                               Margin="14,0,10,0"
                                               TextAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- 详情面板 -->
            <Border Grid.Column="2"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Grid>
                    <!-- 有选中 -->
                    <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <StackPanel Margin="18">

                            <TextBlock Text="字段" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextMuted}"/>

                            <TextBlock x:Name="TxtFieldName" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text}"
                                       TextWrapping="Wrap" Margin="0,6,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Background="{StaticResource Brush.Subtle}" CornerRadius="5" Padding="8,3">
                                    <TextBlock x:Name="TxtFieldKind" FontSize="11"
                                               Foreground="{StaticResource Brush.TextMuted}"/>
                                </Border>
                                <Border x:Name="BadgeModified" Background="#FEF3C7" CornerRadius="5"
                                        Padding="8,3" Margin="6,0,0,0" Visibility="Collapsed">
                                    <TextBlock Text="已修改" FontSize="11"
                                               Foreground="{StaticResource Brush.Modified}"/>
                                </Border>
                            </StackPanel>

                            <!-- 值编辑区（容器节点隐藏） -->
                            <StackPanel x:Name="ValueSection" Margin="0,22,0,0">
                                <TextBlock Text="值" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TxtValue" Style="{StaticResource Input}"
                                         TextChanged="TxtValue_TextChanged"/>
                                <TextBlock x:Name="TxtValueHint" FontSize="11"
                                           Foreground="{StaticResource Brush.TextMuted}"
                                           TextWrapping="Wrap" Margin="0,7,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="ContainerHint" Margin="0,22,0,0" Visibility="Collapsed">
                                <TextBlock Text="这是容器节点，展开左侧查看其子字段。"
                                           FontSize="12" Foreground="{StaticResource Brush.TextMuted}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Margin="0,22,0,0">
                                <TextBlock Text="定位" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextMuted}" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtLocator" FontFamily="Consolas, Microsoft YaHei UI"
                                           FontSize="12" Foreground="{StaticResource Brush.Text}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- 空状态 -->
                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="30">
                        <Border Width="52" Height="52" CornerRadius="26"
                                Background="{StaticResource Brush.Subtle}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="◇" FontSize="24" Foreground="#A8B0BA"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="选中左侧字段查看详情" FontSize="13" Margin="0,14,0,0"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="也可以直接把存档文件拖进窗口打开"
                                   FontSize="11" Margin="0,6,0,0"
                                   Foreground="#9AA3AF" TextAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="2" Margin="0,12,0,0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,7">
            <Grid>
                <TextBlock x:Name="TxtStatus" Text="拖入存档文件，或点击「打开存档」"
                           FontSize="11" Foreground="{StaticResource Brush.TextMuted}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtModified" Text=""
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.Modified}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
